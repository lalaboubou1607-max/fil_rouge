# Copie ce fichier sous le nom .env puis adapte les valeurs.

# Port sur lequel le site répond : http://localhost:3000
PORT=3000

# Adresse de la base MongoDB. Laisse vide pour utiliser une base temporaire en mémoire.
# Exemple avec MongoDB installé : mongodb://127.0.0.1:27017/isen-associations
MONGODB_URI=

# Phrase secrète qui signe les cookies de session. Mets une longue phrase aléatoire.
SESSION_SECRET=change-moi-avec-une-longue-phrase-aleatoire
